+        moe_out = run_experts(cur, up_exps, gate_exps, down_exps, gate_up_exps, up_exps_s, gate_exps_s, down_exps_s,
+                              selected_experts, selected_experts, weights);
+    } else {
+        const int64_t n_sel = n_expert_used*n_tokens;
+        ggml_tensor * sel = ggml_reshape_1d(ctx0, ggml_cont(ctx0, selected_experts), n_sel);
+        ggml_tensor * map = ggml_get_rows(ctx0, hot->table, sel); // [3, n_sel]
+        auto field = [&](int i) {
+            return ggml_cont(ctx0, ggml_view_2d(ctx0, map, 1, n_sel, map->nb[1], i*map->nb[0])); // [1, n_sel]
+        };
+        ggml_tensor * ids_hot  = ggml_reshape_2d(ctx0, ggml_cast(ctx0, field(0), GGML_TYPE_I32), n_expert_used, n_tokens);
+        ggml_tensor * is_hot   = ggml_reshape_3d(ctx0, field(1), 1, n_expert_used, n_tokens);
+        ggml_tensor * ids_cold = ggml_reshape_2d(ctx0, ggml_cast(ctx0, field(2), GGML_TYPE_I32), n_expert_used, n_tokens);
+        cb(ids_hot,  "ffn_moe_hot_ids",  il);
+        cb(ids_cold, "ffn_moe_cold_ids", il);
+
+        ggml_tensor * w_hot  = ggml_mul(ctx0, weights, is_hot);
+        ggml_tensor * w_cold = ggml_sub(ctx0, weights, w_hot);
+
+        ggml_tensor * out_hot  = run_experts(cur, hot->up, hot->gate, hot->down, hot->gate_up, hot->up_s, hot->gate_s, hot->down_s,
+                                             ids_hot, ids_hot, w_hot);
+        cb(out_hot, "ffn_moe_out_hot", il);
+        ggml_tensor * out_cold = run_experts(cur, up_exps, gate_exps, down_exps, gate_up_exps, up_exps_s, gate_exps_s, down_exps_s,
+                                             ids_cold, selected_experts, w_cold);
+        cb(out_cold, "ffn_moe_out_cold", il);
+        moe_out = ggml_add(ctx0, out_hot, out_cold);
     }
 
     cb(moe_out, "ffn_moe_out", il);
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index bdd76f4..030bc2c 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -7,6 +7,7 @@
 #include "llama-mmap.h"
 #include "llama-cparams.h"
 #include "llama-model-loader.h"
+#include "llama-moe-hot.h"
 
 #include "llama-kv-cache.h"
 #include "llama-kv-cache-iswa.h"
@@ -31,8 +32,10 @@
 #include <cstdint>
 #include <cstring>
 #include <cmath>
+#include <fstream>
 #include <functional>
 #include <map>
