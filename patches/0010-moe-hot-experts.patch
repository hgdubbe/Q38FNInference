     }
 
+    if (const char * hot = getenv("LLAMA_MOE_HOT"); hot != nullptr && *hot != 0) {
+        llama_moe_hot_load(*this, hot);
+    }
+
     return true;
 }
 
diff --git a/src/llama-moe-hot.h b/src/llama-moe-hot.h
new file mode 100644
index 0000000..4b3493f
--- /dev/null
+++ b/src/llama-moe-hot.h
@@ -0,0 +1,67 @@
+#pragma once
+
+// Hot MoE experts (LLAMA_MOE_HOT=<file>): for layers whose experts stay in host memory, copies of
+// the most-used experts are kept on the layer's GPU. build_moe_ffn then computes the selected hot
+// experts there and only the rest on the CPU. The file has one line per layer:
+// "<layer>: <expert> <expert> ...". Loaded in llama-model.cpp, used in llama-graph.cpp.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+struct llama_moe_hot {
+    const void * owner = nullptr; // the llama_model
+
+    // [ne0, ne1, n_hot] copies of the chosen experts, in the order they were listed
+    ggml_tensor * up      = nullptr;
+    ggml_tensor * gate    = nullptr;
+    ggml_tensor * down    = nullptr;
+    ggml_tensor * gate_up = nullptr;
+
+    // F32 [n_hot] per-expert output scales, if the layer has them
+    ggml_tensor * up_s   = nullptr;
+    ggml_tensor * gate_s = nullptr;
+    ggml_tensor * down_s = nullptr;
+
+    // F32 [3, n_expert], per expert: its hot slot (0 if not hot), 1/0 whether it is hot, and its
+    // own id if not hot, else -1 (the CPU's mul_mat_id skips those)
+    ggml_tensor * table = nullptr;
+};
+
+struct llama_moe_hot_registry {
+    std::mutex mtx;
+    // keyed by the layer's host-memory gate_up_exps, or up_exps
+    std::unordered_map<const ggml_tensor *, llama_moe_hot> layers;
+    // what each model allocated for them
+    std::unordered_multimap<const void *, std::pair<ggml_context *, ggml_backend_buffer_t>> allocs;
+};
+
+inline llama_moe_hot_registry & llama_moe_hot_reg() {
+    static llama_moe_hot_registry reg;
+    return reg;
+}
+
+inline const llama_moe_hot * llama_moe_hot_find(const ggml_tensor * key) {
+    auto & reg = llama_moe_hot_reg();
+    std::lock_guard<std::mutex> lock(reg.mtx);
+    const auto it = reg.layers.find(key);
+    return it == reg.layers.end() ? nullptr : &it->second;
+}
+
+inline void llama_moe_hot_free(const void * owner) {
+    auto & reg = llama_moe_hot_reg();
+    std::lock_guard<std::mutex> lock(reg.mtx);
+    for (auto it = reg.layers.begin(); it != reg.layers.end();) {
+        it = it->second.owner == owner ? reg.layers.erase(it) : std::next(it);
+    }
+    const auto range = reg.allocs.equal_range(owner);
+    for (auto it = range.first; it != range.second; ++it) {
+        ggml_backend_buffer_free(it->second.second);
+        ggml_free(it->second.first);
+    }
+    reg.allocs.erase(owner);
+}
