 #include <numeric>
 #include <regex>
 #include <sstream>
@@ -1285,6 +1288,155 @@ llama_model::~llama_model() {
     for (auto * lora : loras) {
         delete lora;
     }
+    llama_moe_hot_free(this);
+}
+
+// LLAMA_MOE_HOT (see llama-moe-hot.h): copy the listed experts of host-memory expert tensors to
+// their layer's device
+static void llama_moe_hot_load(llama_model & model, const char * path) {
+    std::ifstream in(path);
+    if (!in) {
+        LLAMA_LOG_WARN("%s: cannot read %s\n", __func__, path);
+        return;
+    }
+    const bool allow_cpu = getenv("LLAMA_MOE_HOT_TEST") != nullptr; // lets a CPU-only build run the split
+    std::map<std::string, size_t> dev_bytes;
+    std::vector<uint8_t> tmp;
+    int n_layers = 0;
+
+    std::string line;
+    while (std::getline(in, line)) {
+        const size_t colon = line.find(':');
+        if (colon == std::string::npos) {
+            continue;
+        }
+        const int il = atoi(line.substr(0, colon).c_str());
+        if (il < 0 || il >= (int) model.layers.size()) {
+            continue;
+        }
+        const llama_layer & L = model.layers[il];
+        ggml_tensor * key = L.ffn_gate_up_exps ? L.ffn_gate_up_exps : L.ffn_up_exps;
+        if (key == nullptr || L.ffn_down_exps == nullptr || key->buffer == nullptr || !ggml_backend_buffer_is_host(key->buffer)) {
+            continue; // not MoE, or its experts are on a GPU already
+        }
+        if (L.ffn_up_exps_b || L.ffn_gate_exps_b || L.ffn_down_exps_b || L.ffn_gate_up_exps_b) {
+            LLAMA_LOG_WARN("%s: layer %d: expert biases are not supported, skipped\n", __func__, il);
+            continue;
+        }
+        bool scales_ok = true;
+        for (const ggml_tensor * sc : { L.ffn_up_exps_s, L.ffn_gate_exps_s, L.ffn_down_exps_s }) {
+            scales_ok = scales_ok && (sc == nullptr || (sc->type == GGML_TYPE_F32 && ggml_nelements(sc) == key->ne[2]));
+        }
+        if (!scales_ok) {
+            LLAMA_LOG_WARN("%s: layer %d: unsupported expert scales, skipped\n", __func__, il);
+            continue;
+        }
+        const int64_t n_expert = key->ne[2];
+
+        std::vector<int32_t> hot;
+        std::vector<int32_t> slot(n_expert, -1);
+        std::istringstream ids(line.substr(colon + 1));
+        for (int64_t e; ids >> e;) {
+            if (e >= 0 && e < n_expert && slot[e] < 0) {
+                slot[e] = (int32_t) hot.size();
+                hot.push_back((int32_t) e);
+            }
+        }
+        if (hot.empty()) {
+            continue;
+        }
+
+        ggml_backend_dev_t dev = model.dev_layer(il);
+        if (dev == nullptr || (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU && !allow_cpu)) {
+            continue; // the whole layer runs on the CPU
+        }
+
+        ggml_init_params params = { ggml_tensor_overhead()*8, nullptr, true };
+        ggml_context * ctx = ggml_init(params);
+        llama_moe_hot h;
+        h.owner = &model;
+        auto copy_of = [&](ggml_tensor * t) -> ggml_tensor * {
+            if (t == nullptr) {
+                return nullptr;
+            }
+            GGML_ASSERT(t->ne[2] == n_expert && ggml_is_contiguous(t));
+            ggml_tensor * c = ggml_new_tensor_3d(ctx, t->type, t->ne[0], t->ne[1], (int64_t) hot.size());
+            ggml_format_name(c, "%s.hot", t->name);
+            return c;
+        };
+        h.up      = copy_of(L.ffn_up_exps);
+        h.gate    = copy_of(L.ffn_gate_exps);
+        h.down    = copy_of(L.ffn_down_exps);
+        h.gate_up = copy_of(L.ffn_gate_up_exps);
+        auto scale_of = [&](ggml_tensor * t) -> ggml_tensor * {
+            if (t == nullptr) {
+                return nullptr;
+            }
+            ggml_tensor * c = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, (int64_t) hot.size());
+            ggml_format_name(c, "%s.hot", t->name);
+            return c;
+        };
+        h.up_s    = scale_of(L.ffn_up_exps_s);
+        h.gate_s  = scale_of(L.ffn_gate_exps_s);
+        h.down_s  = scale_of(L.ffn_down_exps_s);
+        h.table   = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3, n_expert);
+        ggml_format_name(h.table, "blk.%d.ffn_exps_hot_table", il);
+
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_dev_buffer_type(dev));
+        if (buf == nullptr) {
+            LLAMA_LOG_WARN("%s: layer %d: out of device memory for %zu hot experts, skipped\n", __func__, il, hot.size());
+            ggml_free(ctx);
+            continue;
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+        const std::pair<ggml_tensor *, ggml_tensor *> pairs[] = {
+            { L.ffn_up_exps, h.up }, { L.ffn_gate_exps, h.gate }, { L.ffn_down_exps, h.down }, { L.ffn_gate_up_exps, h.gate_up },
+        };
+        for (const auto & [src, dst] : pairs) {
+            if (src == nullptr) {
+                continue;
+            }
+            tmp.resize(src->nb[2]);
+            for (size_t k = 0; k < hot.size(); k++) {
+                ggml_backend_tensor_get(src, tmp.data(), hot[k]*src->nb[2], src->nb[2]);
+                ggml_backend_tensor_set(dst, tmp.data(), k*dst->nb[2], src->nb[2]);
+            }
+        }
+        const std::pair<ggml_tensor *, ggml_tensor *> scales[] = {
+            { L.ffn_up_exps_s, h.up_s }, { L.ffn_gate_exps_s, h.gate_s }, { L.ffn_down_exps_s, h.down_s },
+        };
+        for (const auto & [src, dst] : scales) {
+            if (src == nullptr) {
+                continue;
+            }
+            std::vector<float> all(n_expert), sel(hot.size());
+            ggml_backend_tensor_get(src, all.data(), 0, ggml_nbytes(src));
+            for (size_t k = 0; k < hot.size(); k++) {
+                sel[k] = all[hot[k]];
+            }
+            ggml_backend_tensor_set(dst, sel.data(), 0, ggml_nbytes(dst));
+        }
+        std::vector<float> table(3*n_expert);
+        for (int64_t e = 0; e < n_expert; e++) {
+            table[3*e + 0] = slot[e] >= 0 ? (float) slot[e] : 0.0f;
+            table[3*e + 1] = slot[e] >= 0 ? 1.0f : 0.0f;
+            table[3*e + 2] = slot[e] >= 0 ? -1.0f : (float) e;
+        }
+        ggml_backend_tensor_set(h.table, table.data(), 0, ggml_nbytes(h.table));
+
+        dev_bytes[ggml_backend_buffer_name(buf)] += ggml_backend_buffer_get_size(buf);
+        n_layers++;
+        auto & reg = llama_moe_hot_reg();
+        std::lock_guard<std::mutex> lock(reg.mtx);
+        reg.layers[key] = h;
+        reg.allocs.emplace(&model, std::make_pair(ctx, buf));
+    }
+    LLAMA_LOG_INFO("%s: hot experts for %d layers from %s\n", __func__, n_layers, path);
+    for (const auto & [name, bytes] : dev_bytes) {
+        // same form as the per-buffer lines above, so tools that sum them see this memory too
+        LLAMA_LOG_INFO("%s: %12s model buffer size = %8.2f MiB (hot experts)\n", __func__, name.c_str(), bytes / 1024.0 / 1024.0);
+    }
 }
 
