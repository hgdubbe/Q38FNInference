+// Opt-in QSA block selection (LLAMA_QWEN4EXP_QSA_BLOCKS=1): top-k over the block scores instead
+// of over every cell. The per-cell path expands the scores to [n_kv, n_tokens] f32 and sorts that;
+// this sorts n_kv/ratio values and only expands a mask. It keeps ceil((top_k + ratio - 1)/ratio)
+// blocks, the spare block of unpooled tail cells among them, where the reference keeps exactly
+// top_k + ratio - 1 cells and may take part of one more block (which part depends on how the
+// backend breaks ties). So it is close to the reference, not identical.
+static bool qwen4exp_qsa_blocks() {
+    static const bool enabled = [] {
+        const char * v = getenv("LLAMA_QWEN4EXP_QSA_BLOCKS");
+        return v != nullptr && atoi(v) != 0;
+    }();
+    return enabled;
+}
+
+// flash attention's sparse path compacts every mask row into n_kv_max cells and drops the rest,
+// so this must bound the visible cells: the full blocks plus the spare block, whose unpooled
+// cells are the tail (fewer than ratio in a contiguous sequence); one more block of slack
+static int64_t qwen4exp_qsa_block_width(const llama_hparams & hparams, int il, int64_t n_kv) {
+    const int64_t r     = hparams.dsv4_compress_ratios[il];
+    const int64_t n_sel = ((int64_t) hparams.indexer_top_k + 2*r - 2)/r;
+    return std::min<int64_t>(n_kv, (n_sel + 1)*r);
+}
