+    // opt-in (LLAMA_QWEN4EXP_QSA_BLOCKS=1): select whole blocks, see qwen4exp_qsa_block_width
+    if (blk_bias && qwen4exp_qsa_blocks()) {
+        const int64_t n_sel = std::min<int64_t>(n_blocks, ((int64_t) hparams.indexer_top_k + 2*r - 2)/r);
+
+        ggml_tensor * sel = ggml_top_k(ctx0, score, n_sel); // [n_sel, n_tps, n_stream]
+        cb(sel, "indexer_top_blocks", il);
+
+        // per-block mask: -inf except the selected blocks, set as rows of one like build_attn_qsa does per cell
+        ggml_tensor * blk_mask = ggml_fill(ctx0, ggml_new_tensor_4d(ctx0, GGML_TYPE_F32, 1, n_blocks, n_tps, n_stream), -INFINITY);
+        ggml_tensor * zeros    = ggml_fill(ctx0, ggml_new_tensor_4d(ctx0, GGML_TYPE_F32, 1, n_sel, n_tps, n_stream), 0.0f);
+        blk_mask = ggml_set_rows(ctx0, blk_mask, zeros, ggml_reshape_4d(ctx0, ggml_cont(ctx0, sel), n_sel, n_tps, n_stream, 1));
+        blk_mask = ggml_reshape_3d(ctx0, blk_mask, n_blocks, n_tps, n_stream);
+
+        // to cells through cell_blk (the spare block carries the unpooled tail), then onto the KQ mask
+        ggml_tensor * cell_mask = ggml_get_rows(ctx0,
+                ggml_cont(ctx0, ggml_permute(ctx0, blk_mask, 1, 0, 2, 3)), inp->cell_blk);
+        cell_mask = ggml_permute(ctx0, cell_mask, 1, 0, 2, 3);
+
+        ggml_tensor * mask = ggml_reshape_3d(ctx0, kq_mask, n_kv, n_tps, n_stream);
+        mask = mask->type == GGML_TYPE_F32
+            ? ggml_add(ctx0, mask, cell_mask)
+            : ggml_add_cast(ctx0, mask, cell_mask, mask->type);
+        mask = ggml_reshape_4d(ctx0, mask, n_kv, n_tps, 1, n_stream);
+        cb(mask, "indexer_block_mask", il);
+
+        // a finished mask rather than cell indices; build_attn_qsa tells them apart by type
+        return mask;
+    }
