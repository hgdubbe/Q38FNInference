+// the indexer key store alone, for layers whose QSA budget covers the whole cache
+class llama_model_qwen4exp::llm_graph_input_idx_k : public llm_graph_input_i {
+public:
+    llm_graph_input_idx_k(const llama_memory_hybrid_idx_context * mctx, int64_t budget) : mctx(mctx), budget(budget) {}
+    virtual ~llm_graph_input_idx_k() = default;
+
+    void set_input(const llama_ubatch * ubatch) override {
+        mctx->get_idx()->set_input_k_idxs(k_idxs, ubatch);
+    }
+
+    bool can_reuse(const llm_graph_params & params) override {
+        mctx = static_cast<const llama_memory_hybrid_idx_context *>(params.mctx);
+
+        const auto * idx = mctx->get_idx();
+
+        // a cache grown past the budget needs the sparse graph again
+        return idx != nullptr &&
+            k_idxs->ne[0] == params.ubatch.n_tokens &&
+            budget >= (int64_t) idx->get_n_kv();
+    }
+
+    ggml_tensor * k_idxs = nullptr; // I32 [n_tokens]
+
+    const llama_memory_hybrid_idx_context * mctx;
+
+    // smallest top_k + ratio - 1 of the layers that skipped the indexer
+    int64_t budget;
+};
+
+void llama_model_qwen4exp::graph::build_qsa_store_k(
+        const llama_memory_hybrid_idx_context * mctx_hyb,
+        ggml_tensor *                           cur,
+        int                                     il) {
+    const llama_kv_cache_context * mctx_idx = mctx_hyb->get_idx();
+
+    const int64_t budget = (int64_t) hparams.indexer_top_k + hparams.dsv4_compress_ratios[il] - 1;
+
+    if (idx_k_inp == nullptr) {
+        auto inp = std::make_unique<llm_graph_input_idx_k>(mctx_hyb, budget);
+        inp->k_idxs = mctx_idx->build_input_k_idxs(ctx0, ubatch);
+        idx_k_inp = inp.get();
+        res->add_input(std::move(inp));
+    } else {
+        idx_k_inp->budget = std::min(idx_k_inp->budget, budget);
+    }
+
+    // same raw key as build_qsa_top_k caches
+    ggml_tensor * k_raw = build_lora_mm(model.layers[il].index_k_proj, cur);
+    k_raw = ggml_reshape_3d(ctx0, k_raw, hparams.indexer_head_size, 1, n_tokens);
+    cb(k_raw, "indexer_k_raw", il);
+
+    ggml_build_forward_expand(gf, mctx_idx->cpy_k(ctx0, k_raw, idx_k_inp->k_idxs, il));
+}
