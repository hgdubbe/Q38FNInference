+// x86 builds carry the tiled K-quant matmul (tiled/tiled.cpp), which reads the original layout.
+// For Q4_K and Q2_K it is ~2x faster than the repacked gemm at prompt batches (512 tokens, dense
+// and MoE) and even at batch 1, and a repacked tensor can't use it, so leave those unrepacked.
+static bool ggml_repack_prefer_tiled() {
+#if defined(__AVX512VNNI__) || defined(__AVX2__) || defined(__AVX__)
+    static const bool tiled = [] {
+        const char * env = getenv("GGML_CPU_TILED_MM");
+        return env == NULL || atoi(env) != 0;
+    }();
+    return tiled;
+#else
+    return false;
+#endif
+}
